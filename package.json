{
  "name": "mike.pezz.io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsx scripts/postbuild.ts",
    "preview": "vite preview --outDir build/client",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "prettier --write ."
  },
  "dependencies": {
    "isbot": "^5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@mdx-js/react": "^3",
    "@mdx-js/rollup": "^3",
    "@react-router/dev": "^8",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/mdast": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react-hooks": "^6",
    "jsdom": "^26",
    "mdast-util-from-markdown": "^2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3",
    "prettier": "^3",
    "remark-frontmatter": "^5",
    "remark-gfm": "^4",
    "remark-mdx-frontmatter": "^5",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vite": "^8.0.3",
    "vitest": "^4"
  }
}
